# Core
NODE_ENV=development
PORT=8080
API_PREFIX=/v1

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/salonx

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Auth / JWT
JWT_SECRET=change_me
JWT_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
HASH_ROUNDS=10

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Twilio
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+1XXX

# S3
S3_REGION=us-east-1
S3_BUCKET=salonx-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=node-ts-express-api

# Rate limit & CORS
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
CORS_ORIGIN=http://localhost:5173

# Feature flags
FEATURE_TOKENS=off
FEATURE_AI=on
FEATURE_VOICE=on

# AI/Voice providers
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Vector/Embeddings
USE_PGVECTOR=on
EMBEDDING_DIM=1536
